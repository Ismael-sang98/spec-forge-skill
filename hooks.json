{
  "spec-forge-smart-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/spec-gate.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
